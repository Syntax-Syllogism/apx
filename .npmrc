# @syntax-syllogism/docs-theme is published only to GitHub Packages, and yarn v1
# sends the GitHub token (//npm.pkg.github.com/:_authToken) only for scopes mapped
# to that registry. Public-npm-only @syntax-syllogism deps (none today) would stay
# pinned to registry.yarnpkg.com URLs in yarn.lock. To add or upgrade one, override
# the mapping for that single command, e.g.:
#   npm_config_@syntax-syllogism:registry=https://registry.npmjs.org yarn add <pkg>
@syntax-syllogism:registry=https://npm.pkg.github.com
